# Polysite settings, written by `polysite init` on {{DATE}}.
# This file holds secrets. Keep it out of version control, readable by you only, and keep a copy somewhere safe:
# PAYLOAD_SECRET in particular encrypts stored credentials, so a restore onto a new server needs the same value.
# Check it any time with `polysite doctor`.

# --- Which release runs (change it with `polysite upgrade`) ---
POLYSITE_VERSION={{POLYSITE_VERSION}}
POLYSITE_REGISTRY={{POLYSITE_REGISTRY}}

# --- Domains. Both must point at this server before the first start (Caddy gets certificates for them) ---
SITE_DOMAIN={{SITE_DOMAIN}}
SITE_SCHEME={{SCHEME}}
CMS_DOMAIN={{CMS_DOMAIN}}
CMS_SCHEME={{SCHEME}}

# --- Database ---
POSTGRES_USER={{POSTGRES_USER}}
POSTGRES_PASSWORD={{POSTGRES_PASSWORD}}
POSTGRES_DB={{POSTGRES_DB}}
POSTGRES_MAJOR={{POSTGRES_MAJOR}}
DATABASE_URL={{DATABASE_URL}}

# --- Secrets (generated; never reuse them elsewhere) ---
PAYLOAD_SECRET={{PAYLOAD_SECRET}}
NUXT_REVALIDATE_SECRET={{REVALIDATE_SECRET}}
REVALIDATE_SECRET={{REVALIDATE_SECRET}}
# Asked for on the first-run setup page so only whoever controls the server can create the first administrator.
POLYSITE_SETUP_TOKEN={{SETUP_TOKEN}}

# --- App wiring (normally left alone) ---
PAYLOAD_PUBLIC_SERVER_URL={{SCHEME}}://{{CMS_DOMAIN}}
NUXT_PUBLIC_API_BASE=/api
NUXT_API_BASE_INTERNAL=http://cms:3001/api
NUXT_REVALIDATE_URL=http://web:3000/api/revalidate
REDIS_URL=redis://redis:6379

# --- Backups (docs/guide/backups.md) ---
BACKUP_HOST_DIR=./backups
BACKUP_SCHEDULE=17 3 * * *
BACKUP_VERIFY_SCHEDULE=47 4 * * 0
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
# Encrypts each archive. Without this value the backups cannot be opened: keep it with PAYLOAD_SECRET, not on this server only.
BACKUP_ENCRYPTION_PASSPHRASE={{BACKUP_PASSPHRASE}}
# Off-site copy (any rclone remote). A backup on the same machine does not survive losing the machine.
# BACKUP_RCLONE_REMOTE=offsite:my-bucket/polysite
# A monitoring URL pinged after each backup (healthchecks.io style).
# BACKUP_PING_URL=

# --- Plugins: comma separated folder names to switch off without deleting anything ---
# POLYSITE_PLUGINS_OFF=

# --- Email (only if you use the email plugin) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM_ADDRESS=
